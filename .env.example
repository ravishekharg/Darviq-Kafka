# Copy this file to .env and adjust as needed. .env itself is gitignored.
# None of these are secrets against the local Docker Compose broker (it
# has no auth) -- they're just tunables kept out of code so the same
# scripts work unmodified against a different (e.g. SASL-secured) cluster
# later without a code change, only a config change.

# --- Shared Kafka connection ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=raw.iot-telemetry

# --- Producer (producer/producer.py) ---
NUM_DEVICES=25
EVENTS_PER_SECOND=10
MALFORMED_RATE=0.03
LATE_EVENT_RATE=0.06
DUPLICATE_RATE=0.02
OFFLINE_FLIP_PROBABILITY=0.002
MAX_OFFLINE_TICKS=40
MAX_LATE_SECONDS=240
RUN_SECONDS=0
# RANDOM_SEED=42

# --- Spark job (spark_job/streaming_job.py) ---
OUTPUT_PATH=./data/output/aggregates
DEAD_LETTER_PATH=./data/output/dead_letter
CHECKPOINT_PATH=./data/checkpoints
WINDOW_DURATION=1 minute
WATERMARK_DELAY=2 minutes
TRIGGER_INTERVAL=30 seconds
STARTING_OFFSETS=latest
